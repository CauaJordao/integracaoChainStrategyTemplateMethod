        graph [fontname="DejaVu Sans",bgcolor="white",pad="0.35",nodesep="0.5",ranksep="0.75",splines=polyline];
        node [shape=box,style="rounded,filled",color="#4F46E5",fillcolor="#EEF2FF",fontcolor="#111827",fontname="DejaVu Sans",fontsize=12,margin="0.18,0.13"];
